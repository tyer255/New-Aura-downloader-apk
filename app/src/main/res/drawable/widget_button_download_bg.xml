<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Electric Blue Gradient Fill (#2D8CFF to #0052FF) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="135"
                android:startColor="#FF2D8CFF"
                android:endColor="#FF0052FF" />
        </shape>
    </item>

    <!-- Top Glossy Reflection Sheen -->
    <item android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#35FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Crisp White Glass Border Edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
