    android:width="280dp"
    android:height="90dp"
    android:viewportWidth="280"
    android:viewportHeight="90">

    <!-- Outer Soft Electric Blue Ambient Glow Rim -->
    <path
        android:pathData="M18,0 h244 a18,18 0 0 1 18,18 v54 a18,18 0 0 1 -18,18 h-244 a18,18 0 0 1 -18,-18 v-54 a18,18 0 0 1 18,-18 z"
