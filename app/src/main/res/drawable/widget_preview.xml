        android:strokeWidth="1"
        android:strokeColor="#20FFFFFF" />

    <!-- Link Icon inside Input Bar -->
    <path
        android:pathData="M90,28 a3.5,3.5 0 0,0 5,0l2,-2"
        android:strokeWidth="1.5"
        android:strokeColor="#2D8CFF"
        android:strokeLineCap="round"/>

