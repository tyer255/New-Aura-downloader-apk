        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="280"
                android:endY="90"
                android:type="linear">
                <item android:color="#85161720" android:offset="0.0" />
                <item android:color="#66101117" android:offset="0.5" />
                <item android:color="#850C0D14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Border Rim (Electric Blue Glass Edge) -->
    <path
        android:pathData="M18,1 h244 a17,17 0 0 1 17,17 v54 a17,17 0 0 1 -17,17 h-244 a17,17 0 0 1 -17,-17 v-54 a17,17 0 0 1 17,-17 z"
