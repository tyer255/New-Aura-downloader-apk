                android:startY="17"
                android:endX="60"
                android:endY="73"
                android:type="linear">
                <item android:color="#0066FF" android:offset="0.0" />
                <item android:color="#8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Logo Inner White Download Arrow -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,33 h8 v11 h7 l-11,11 l-11,-11 h7 z" />

    <!-- Top Row: URL Input Bar Container -->
    <path
        android:pathData="M90,13 h160 a14,14 0 0 1 14,14 v6 a14,14 0 0 1 -14,14 h-160 a14,14 0 0 1 -14,-14 v-6 a14,14 0 0 1 14,-14 z"
