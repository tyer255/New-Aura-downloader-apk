                android:startY="16"
                android:endX="264"
                android:endY="44"
                android:type="linear">
                <item android:color="#FF2D8CFF" android:offset="0.0" />
                <item android:color="#FF0052FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Row: Electric Blue "Download" Button -->
    <path
        android:pathData="M90,52 h160 a14,14 0 0 1 14,14 v6 a14,14 0 0 1 -14,14 h-160 a14,14 0 0 1 -14,-14 v-6 a14,14 0 0 1 14,-14 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="80"
                android:startY="52"
                android:endX="260"
                android:endY="86"
                android:type="linear">
                <item android:color="#FF2D8CFF" android:offset="0.0" />
                <item android:color="#FF0052FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Download Button Border -->
    <path
        android:pathData="M90,52 h160 a14,14 0 0 1 14,14 v6 a14,14 0 0 1 -14,14 h-160 a14,14 0 0 1 -14,-14 v-6 a14,14 0 0 1 14,-14 z"
