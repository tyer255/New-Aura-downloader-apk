<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Electric Blue Neon Ambient Glow Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#252D8CFF" />
        </shape>
    </item>

    <!-- Translucent Dark Glass Body (allows wallpaper to show through with frosted glass effect) -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#85161720"
                android:centerColor="#66101117"
                android:endColor="#850C0D14" />
            <stroke
                android:width="1.2dp"
                android:color="#602D8CFF" />
        </shape>
    </item>

    <!-- Top Glossy Sheen Reflection -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
