<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_download"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_quick_download"
        android:shortcutLongLabel="@string/shortcut_quick_download">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.auradownloader.app"
            android:targetClass="com.auradownloader.app.MainActivity">
            <extra android:name="shortcut_action" android:value="quick_download"/>
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="youtube_shorts"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_youtube_shorts"
        android:shortcutLongLabel="@string/shortcut_youtube_shorts">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.auradownloader.app"
            android:targetClass="com.auradownloader.app.MainActivity">
            <extra android:name="shortcut_action" android:value="youtube_shorts"/>
        </intent>
    </shortcut>
</shortcuts>
