<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Left Side: Aura Downloader App Logo -->
    <ImageView
        android:id="@+id/widget_app_logo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/app_logo"
        android:contentDescription="Aura Downloader Logo"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="12dp" />

    <!-- Right Side: FrameLayout to toggle states -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical">

        <!-- STATE 1: DEFAULT -->
        <LinearLayout
            android:id="@+id/widget_state_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Row: Rounded URL Input Bar -->
            <LinearLayout
                android:id="@+id/btn_widget_paste_bar"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="3dp"
                android:background="@drawable/widget_input_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_link" />

                <TextView
                    android:id="@+id/widget_text_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:text="Paste your link..."
                    android:textColor="#A8A8A8"
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <LinearLayout
                    android:id="@+id/btn_widget_paste_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/widget_paste_chip"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paste"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Row: Download Button -->
            <LinearLayout
                android:id="@+id/btn_widget_download"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/widget_button_download_bg"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Download"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_download_tray" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATE 2: LOADING -->
        <LinearLayout
            android:id="@+id/widget_state_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="#2D8CFF" />
            <TextView
                android:id="@+id/widget_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Fetching..."
                android:textColor="#A8A8A8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- STATE 3: QUALITIES -->
        <LinearLayout
            android:id="@+id/widget_state_qualities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Quality:"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <Button
                    android:id="@+id/widget_btn_q1"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="HD"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2D8CFF"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/widget_btn_q2"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SD"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161720"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/widget_btn_q3"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Audio"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161720"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
